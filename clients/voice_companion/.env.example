# VC-1 Voice Companion Environment Configuration Example
# Copy to .env and fill in the values. Do not commit actual secrets to git!

# Fish Audio API
FISH_API_KEY=
FISH_VOICE_ID=4c11d21b14284d428074f76a1cf32298

# LLM / Ollama API
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash:0731

# VC-2.3-05 Web Security & Guardrails
# VOICE_WEB_TOKEN: Required when web.host is non-loopback (e.g. 0.0.0.0)
VOICE_WEB_TOKEN=

# VOICE_WEB_ALLOWED_ORIGINS: Comma-separated allowlist of origins (e.g. https://akane.brynetsolutions.com,https://localhost:8765)
VOICE_WEB_ALLOWED_ORIGINS=
