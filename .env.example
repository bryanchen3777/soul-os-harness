# Soul OS — environment variables
# 複製成 .env 並填入真實 key，.env 不進 git

# LLM provider 選擇："openai" | "claude" | "mock"
LLM_PROVIDER=mock

# OpenAI（若 LLM_PROVIDER=openai）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude（若 LLM_PROVIDER=claude）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Heartbeat tick interval（秒；本地開發可調小，例 5）
HEARTBEAT_TICK_SECONDS=60

# 日誌等級
SOUL_LOG_LEVEL=INFO
