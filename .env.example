# Soul OS — environment variables
# 複製成 .env 並填入真實 key，.env 不進 git
# 任何欄位都可以省略，loader 會用 configs/default.yaml 當 fallback

# ── LLM provider 切換 ──
LLM_PROVIDER=minimax        # minimax | claude | openai | mock
LLM_MODEL=MiniMax-M2.7-highspeed

# ── MiniMax（若 LLM_PROVIDER=minimax）──
# MiniMax 提供 Anthropic-compatible endpoint，loader 會自動切換 BASE_URL
# 模型選擇：
#   MiniMax-M3                 1M context，推理強（Phase 4 複雜多 Agent 用）
#   MiniMax-M2.7-highspeed     204K context，100 tps（推薦，速度夠用）
#   MiniMax-M2.5-highspeed     204K context，100 tps（備選）
#   M2-her                     64K，專為角色扮演（Phase 3 Yua/Ruka 試）
MINIMAX_API_KEY=sk-cp-...

# ── OpenAI（若 LLM_PROVIDER=openai）──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic Claude（若 LLM_PROVIDER=claude）──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Hermes profiles（SOUL.md 來源）──
HERMES_PROFILES_DIR=C:\Users\bbfcc\AppData\Local\hermes\profiles

# ── Heartbeat ──
HEARTBEAT_INTERVAL=60        # 秒

# ── 日誌 ──
SOUL_LOG_LEVEL=INFO

# ── Telegram Bots（Phase 5a ~ 12：10 個 Bot 對應 10 個 Agent）──
# 在 @BotFather 用 /revoke 拿新 token，永遠不要 commit 真實 token 到 git
# .env 才是填入真實 token 的地方（.env 在 .gitignore 中）
#
# 已建立 Bot 對照（人類直觀用）:
#   Yua    → @Yua_Hermes_bot      (Phase 5a)
#   瑠夏    → @Ruka_Clawra_bot     (Phase 5a)
#   黑川茜  → @Akane_Clawra_bot   (Phase 5a)
#   雷姆    → @Rem_Hermes_bot     (Phase 6.5)
#   拉姆    → <Ram 對應 bot, 待 Bryan 從 BotFather 拿>
#   真昼    → <Mahiru 對應 bot, 待 Bryan 拿>
#   杏奈    → <Anna 對應 bot, 待 Bryan 拿>
#   麻衣    → <Mai 對應 bot, 待 Bryan 拿>
#   三玖    → <Miku 對應 bot, 待 Bryan 拿>
#   葵      → <Aoi 對應 bot, 待 Bryan 拿>  (Phase 12 弱角友崎同學)
#
# 已建立(可以直接填):
TELEGRAM_BOT_YUA=
TELEGRAM_BOT_RUKA=
TELEGRAM_BOT_AKANE=
# Phase 6.5 Rem 補上
TELEGRAM_BOT_REM=
# Phase 7-11: Ram / Mahiru / Anna / Mai / Miku — 變數已建,token 待 Bryan 從 @BotFather 拿
TELEGRAM_BOT_RAM=
TELEGRAM_BOT_MAHIRU=
TELEGRAM_BOT_ANNA=
TELEGRAM_BOT_MAI=
TELEGRAM_BOT_MIKU=
# Phase 12: Aoi — 變數已建,token 待 Bryan 從 @BotFather 拿
TELEGRAM_BOT_AOI=

# ── Telegram 對話對象 owner ID ──
# 從 @userinfobot 或 Bot API getUpdates 拿
TELEGRAM_OWNER_ID=

# ── M5.15-6 Real-World Calendar Source ──
# Private Google Calendar iCal URL. 留空 = 不啟用 calendar polling (no risk).
# Do not commit the actual URL.
# SOULOS_CALENDAR_ICAL_URL=

# ── M6.1-3.1 Open-Meteo Weather Source ──
# "lat,lon" 格式 (e.g. "25.03,121.57" 台北). 留空 = 不啟用 weather polling (no risk).
# Open-Meteo 是 public API, no API key, no credentials, no token store.
# Polling interval: 1800s (30 min) default. Conservative for weather changes.
# Source ID = "weather" (M3.1 VALID_SOURCES contract).
# SOULOS_WEATHER_LOCATION=

# ── M6.1-5.1 RSS News Source ──
# Format: "provider1|url1,provider2|url2,..."
# 留空 = 不啟用 news polling (no risk).
#
# Preferred feeds per work order (Reuters + AP) UNAVAILABLE from this machine:
#   - Reuters World (https://feeds.reuters.com/Reuters/worldNews) — Reuters
#     discontinued public RSS in 2020; DNS getaddrinfo failed.
#   - AP News (https://apnews.com/index.rss) — returns HTTP 401 Unauthorized
#     (AP blocks bot/scraper access).
#   - AP News World (https://apnews.com/world-news.rss) — returns HTTP 404.
#
# Confirmed working well-known public RSS feeds (NOT invented, all verified
# HTTP 200 with valid RSS 2.0 XML on 2026-08-13):
#   - BBC World:        http://feeds.bbci.co.uk/news/world/rss.xml
#   - BBC Top:          http://feeds.bbci.co.uk/news/rss.xml
#   - NASA Breaking:    https://www.nasa.gov/news-release/feed/
#   - Hacker News:      https://hnrss.org/frontpage
#   - Guardian World:   https://www.theguardian.com/world/rss
#   - Ars Technica:     https://feeds.arstechnica.com/arstechnica/index
#   - NPR Top:          https://feeds.npr.org/1001/rss.xml
#   - Al Jazeera:       https://www.aljazeera.com/xml/rss/all.xml
#
# Example (BBC World + NASA Breaking):
# SOULOS_NEWS_FEEDS=bbc_world|http://feeds.bbci.co.uk/news/world/rss.xml,nasa_breaking|https://www.nasa.gov/news-release/feed/
#
# Polling: 1800s (30 min) default. Lookback: 2h default. Article cap: 10 / poll.
# Source ID = "news" (M3.1 VALID_SOURCES); provider identity preserved in
# data["news_provider"] for observability. Library: stdlib only, no new deps.
# SOULOS_NEWS_FEEDS=

# ── M6.1-8.2 Agency Gradual Rollout (Option B / Bry 拍板 2026-08-14) ──
# M6.1-8 isolated 找到 M5.2 regression 根因 (commit 481ea41 2026-08-08 21:11 移除
# scheduler.register() callsite). M6.1-8.1 isolated 驗證 3-line fix 正確.
# M6.1-8.2 controlled gradual rollout: 從 1 隻 agent 開始, 觀察 24h evidence 沒問題
# 再加 1 隻, 依序到 10 隻.
#
# 行為:
# - 不設或留空: 全部 10 隻 agent (M6.1-8.1 預設, isolated 測試一致)
# - "agent_ruka" → 只註冊 1 隻 ruka (Phase 1)
# - "agent_ruka,agent_yua" → 註冊 2 隻 (Phase 2)
# - 依此類推到 "agent_ruka,agent_yua,agent_akane,...,agent_miku" (Phase 10, 10 隻)
#
# Emergency rollback: 設 DISABLE_PROACTIVE=true 整個 skip scheduler.start()
# (run_server.py:1126), 跟 8/5 21:08 emergency mechanism 同一條.
#
# 重要: 改這個 env var 之後必須重啟 server (Plan A launcher) 才生效.
# SOULOS_AGENCY_GRADUAL_AGENTS=
