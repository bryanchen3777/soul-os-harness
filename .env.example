# Soul OS — environment variables
# 複製成 .env 並填入真實 key，.env 不進 git
# 任何欄位都可以省略，loader 會用 configs/default.yaml 當 fallback

# ── LLM provider 切換 ──
LLM_PROVIDER=minimax        # minimax | claude | openai | mock
LLM_MODEL=MiniMax-M2.7-highspeed

# ── MiniMax（若 LLM_PROVIDER=minimax）──
# MiniMax 提供 Anthropic-compatible endpoint，loader 會自動切換 BASE_URL
# 模型選擇：
#   MiniMax-M3                 1M context，推理強（Phase 4 複雜多 Agent 用）
#   MiniMax-M2.7-highspeed     204K context，100 tps（推薦，速度夠用）
#   MiniMax-M2.5-highspeed     204K context，100 tps（備選）
#   M2-her                     64K，專為角色扮演（Phase 3 Yua/Ruka 試）
MINIMAX_API_KEY=sk-cp-...

# ── OpenAI（若 LLM_PROVIDER=openai）──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic Claude（若 LLM_PROVIDER=claude）──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Hermes profiles（SOUL.md 來源）──
HERMES_PROFILES_DIR=C:\Users\bbfcc\AppData\Local\hermes\profiles

# ── Heartbeat ──
HEARTBEAT_INTERVAL=60        # 秒

# ── 日誌 ──
SOUL_LOG_LEVEL=INFO

# ── Telegram Bots（Phase 5a ~ 11：9 個 Bot 對應 9 個 Agent）──
# 在 @BotFather 用 /revoke 拿新 token，永遠不要 commit 真實 token 到 git
# .env 才是填入真實 token 的地方（.env 在 .gitignore 中）
#
# 已建立 Bot 對照（人類直觀用）:
#   Yua    → @Yua_Hermes_bot      (Phase 5a)
#   瑠夏    → @Ruka_Clawra_bot     (Phase 5a)
#   黑川茜  → @Akane_Clawra_bot   (Phase 5a)
#   雷姆    → @Rem_Hermes_bot     (Phase 6.5)
#   拉姆    → <Ram 對應 bot, 待 Bryan 從 BotFather 拿>
#   真昼    → <Mahiru 對應 bot, 待 Bryan 拿>
#   杏奈    → <Anna 對應 bot, 待 Bryan 拿>
#   麻衣    → <Mai 對應 bot, 待 Bryan 拿>
#   三玖    → <Miku 對應 bot, 待 Bryan 拿>
#
# 已建立(可以直接填):
TELEGRAM_BOT_YUA=
TELEGRAM_BOT_RUKA=
TELEGRAM_BOT_AKANE=
# Phase 6.5 Rem 補上
TELEGRAM_BOT_REM=
# Phase 7-11: Ram / Mahiru / Anna / Mai / Miku — 變數已建,token 待 Bryan 從 @BotFather 拿
TELEGRAM_BOT_RAM=
TELEGRAM_BOT_MAHIRU=
TELEGRAM_BOT_ANNA=
TELEGRAM_BOT_MAI=
TELEGRAM_BOT_MIKU=

# ── Telegram 對話對象 owner ID ──
# 從 @userinfobot 或 Bot API getUpdates 拿
TELEGRAM_OWNER_ID=
